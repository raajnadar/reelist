{
  "name": "reelist",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web && node scripts/not-found-head.js dist",
    "prerender:seed": "node scripts/prerender-seed.js",
    "seo": "rootnative-seo dist",
    "seo:audit": "rootnative-seo audit dist",
    "seo:browse": "rootnative-seo browse dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "yarn lint && yarn typecheck && yarn format:check && yarn test",
    "routes:types": "node scripts/generate-route-types.js",
    "typecheck": "yarn routes:types && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo/log-box": "^58.0.13",
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-vector-icons/material-design-icons": "13.1.4",
    "@rootnative/components": "0.0.0-alpha.29",
    "@rootnative/core": "0.0.0-alpha.29",
    "@rootnative/inertia": "0.0.20",
    "@rootnative/seo": "0.0.0-alpha.29",
    "expo": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/router-server": "~58.0.14",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-native": "^5",
    "expo-server": "~58.0.5",
    "globals": "^16",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  }
}
