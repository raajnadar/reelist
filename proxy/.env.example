# The proxy's server environment. These values never reach the app.
#
# For a deployment, set them with `vercel env add <NAME> production` rather than
# from a file, then deploy again — a function reads its environment when it is
# built. For local work, `vercel dev` reads .env.local, which is gitignored.

# The TMDB v3 API key, 32 characters, from themoviedb.org/settings/api. Use the
# v3 key and not the longer v4 token. This is the value the whole proxy exists
# to keep off the device.
TMDB_API_KEY=

# The rate limit counter, from a free database at console.upstash.com.
#
# Use the REST URL and token, not the redis:// connection string: the edge
# runtime has no TCP socket, so this client speaks HTTP.
#
# Both are optional. Without them the proxy runs with no rate limit and reports
# nothing, so set them on any deployment that is reachable from the internet.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
