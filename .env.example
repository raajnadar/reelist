# Copy this file to .env. .env is gitignored.
#
# The app holds no TMDB key. It calls the proxy in proxy/, and the proxy adds
# the key on the server. See proxy/README.md to deploy it.
#
# This URL is public by design: it is an address, not a credential. Anything
# behind EXPO_PUBLIC_ is inlined into the JavaScript bundle at build time and
# can be read out of the web build, the .apk, and the .ipa. Never put the TMDB
# key here — that is the mistake the proxy exists to prevent.
#
# For local work, run the proxy with `cd proxy && vercel dev` and use its URL.
# Metro caches this value, so restart with `yarn start --clear` after a change.
EXPO_PUBLIC_TMDB_PROXY_URL=https://your-proxy.vercel.app/api/tmdb
